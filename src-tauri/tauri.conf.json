{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "esi-pdf-sign",
  "version": "0.1.0",
  "identifier": "com.esi.pdfsign",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ESI PDF Sign",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
